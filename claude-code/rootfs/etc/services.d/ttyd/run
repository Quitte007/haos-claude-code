#!/usr/bin/with-contenv bashio

# Read addon options
HA_URL=$(bashio::config 'ha_url')
MODEL=$(bashio::config 'claude_model')

# Persist Claude credentials across restarts in /data (HA persistent volume)
export HOME=/data
export ANTHROPIC_MODEL="${MODEL}"
export HA_URL
export SUPERVISOR_TOKEN="${SUPERVISOR_TOKEN}"

# Only export an API key if the user explicitly set one.
# Otherwise Claude uses the Pro/Max subscription login stored in /data/.claude.
if bashio::config.has_value 'anthropic_api_key'; then
    ANTHROPIC_API_KEY=$(bashio::config 'anthropic_api_key')
    export ANTHROPIC_API_KEY
    bashio::log.info "Using Anthropic API key from config."
else
    bashio::log.info "No API key set — using Pro/Max subscription login (run /login on first start)."
fi

mkdir -p /data/.claude

bashio::log.info "Starting Claude Code terminal on port 7681..."

exec ttyd \
    --port 7681 \
    --interface 0.0.0.0 \
    --writable \
    --max-clients 2 \
    --client-option "fontSize=14" \
    --client-option "fontFamily=monospace" \
    /usr/local/bin/claude-ha-wrapper.sh
